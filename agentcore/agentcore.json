{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "equiroutesentinel",
  "version": 1,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "equiroutesentinel",
      "build": "CodeZip",
      "entrypoint": "dist/dualMain.js",
      "codeLocation": "app/agent/",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "envVars": [
        {
          "name": "OTEL_TRACES_EXPORTER",
          "value": "none"
        },
        {
          "name": "EQUIROUTE_BASE_URL",
          "value": ""
        },
        {
          "name": "STUDIO_DEPLOYED_RUNTIME",
          "value": "true"
        },
        {
          "name": "EQUIROUTE_QUOTE_WALLET_ADDRESS",
          "value": "0x30B146dF82aDB5e32155ea1bA94d016bf95bF2D5"
        }
      ],
      "runtimeVersion": "NODE_22"
    }
  ]
}
